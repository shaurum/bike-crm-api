# ===========================================
# Шаблон .env: скопируйте в .env, заполните секреты (см. SETUP_WORK_PC.md)
# Секреты в git не попадают; dev-заглушки ниже — меняйте в проде
# ===========================================
# ЛОКАЛЬНАЯ РАЗРАБОТКА (Windows + Docker Desktop)
# ===========================================

# --------------------------
# Общие настройки
# --------------------------
PROJECT_NAME=bike-crm
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
API_V1_PREFIX=/api/v1

# --------------------------
# База данных (PostgreSQL в Docker)
# --------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bike_crm
POSTGRES_PASSWORD=bike_crm_dev_password
POSTGRES_DB=bike_crm
DATABASE_URL=postgresql+asyncpg://bike_crm:bike_crm_dev_password@postgres:5432/bike_crm

# --------------------------
# Redis (в Docker)
# --------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --------------------------
# Backend (FastAPI)
# --------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
BACKEND_WORKERS=1

# --------------------------
# Frontend (Next.js)
# --------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WIDGET_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# --------------------------
# Celery (асинхронные задачи)
# --------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# --------------------------
# JWT / Auth
# --------------------------
JWT_SECRET_KEY=dev-jwt-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --------------------------
# Публичный API (виджет)
# --------------------------
PUBLIC_API_KEY=dev-public-api-key-change-in-production
WIDGET_CORS_ORIGINS=["*"]

# --------------------------
# Интеграции (заполнить в спринте 2)
# --------------------------
# Avito
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_REDIRECT_URI=https://gateway.vzuhandgo.ru/avito/callback
AVITO_WEBHOOK_SECRET=

# VK
VK_GROUP_ID=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_CALLBACK_SECRET=
VK_CONFIRMATION_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_IDS=

# Email (Resend / SendGrid / SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@localhost

# --------------------------
# S3 / Файловое хранилище (для бэкапов и файлов)
# --------------------------
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bike-crm-backups
S3_REGION=ru-1

# --------------------------
# Мониторинг
# --------------------------
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# --------------------------
# Договоры
# --------------------------
CONTRACT_TEMPLATE_PATH=/app/templates/contract.html
# --------------------------
# Shlyuz integraciy (cloud gateway)
# --------------------------
GATEWAY_URL=https://gateway.vzuhandgo.ru
GATEWAY_TOKEN=
