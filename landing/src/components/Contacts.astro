---
import { site } from '../config/site';
---
<section class="section section--tight" id="contacts">
  <div class="container contacts">
    <div class="contacts__content">
      <span class="section__eyebrow">Контакты</span>
      <h2>Готовы к поездке? Свяжитесь с нами</h2>
      <p>Ответим быстро и подскажем по наличию байков.</p>
      <div class="contacts__actions">
        <a class="btn btn--yellow" href={`tel:${site.phoneRaw}`}>Позвонить: {site.phone}</a>
        <a class="btn btn--ghost" href={site.telegram} target="_blank" rel="noopener">Написать в Telegram</a>
        <a class="btn btn--ghost" href={site.whatsapp} target="_blank" rel="noopener">Написать в WhatsApp</a>
        {site.avito && <a class="btn btn--ghost" href={site.avito} target="_blank" rel="noopener">Авито</a>}
      </div>
    </div>
    <div class="contacts__card">
      <div class="contacts__card-inner">
        <span class="contacts__label">Основной контакт</span>
        <a class="contacts__phone" href={`tel:${site.phoneRaw}`}>{site.phone}</a>
        <div class="contacts__links">
          <a href={site.telegram} target="_blank" rel="noopener">Telegram: @VZUH_and_go_bot</a>
          <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contacts {
    display: grid;
    gap: clamp(2rem, 6vw, 3rem);
    align-items: center;
  }
  .contacts__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .contacts__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.8rem;
  }
  .contacts__card {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(245, 185, 27, 0.9) 0%, rgba(245, 185, 27, 0.6) 100%);
    padding: 1px;
  }
  .contacts__card-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: 27px;
    background: radial-gradient(circle at top right, rgba(255,255,255,0.9), rgba(255,255,255,1));
    padding: clamp(2rem, 6vw, 3.6rem);
  }
  .contacts__label {
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .contacts__phone {
    font-family: 'Unbounded', sans-serif;
    font-weight: 800;
    font-size: clamp(2rem, 6vw, 3.6rem);
    color: var(--ink);
    text-decoration: none;
  }
  .contacts__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .contacts__links a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .contacts__links a:hover {
    text-decoration: underline;
  }
  @media (min-width: 960px) {
    .contacts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
