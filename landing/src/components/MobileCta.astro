---
import { site } from '../config/site';
---
<div class="mobile-cta">
  <a class="mobile-cta__main" href={`tel:${site.phoneRaw}`}>Позвонить</a>
  <div class="mobile-cta__group">
    <a href={site.telegram} target="_blank" rel="noopener" aria-label="Telegram">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9.78 18.65L10.06 14.42L17.74 7.5C18.08 7.19 17.67 7.04 17.22 7.31L7.74 13.3L3.64 12C2.76 11.75 2.75 11.14 3.84 10.7L19.81 4.54C20.54 4.21 21.24 4.72 20.96 5.84L18.24 18.65C18.05 19.56 17.5 19.78 16.74 19.36L12.6 16.3L10.61 18.23C10.38 18.46 10.19 18.65 9.78 18.65Z" fill="currentColor"/>
      </svg>
    </a>
    <a href={site.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 11.5C20 16.194 16.194 20 11.5 20C10.14 20 8.86 19.7 7.73 19.18L4 20L4.82 16.27C4.3 15.14 4 13.86 4 12.5C4 7.806 7.806 4 12.5 4C17.194 4 21 7.806 21 12.5H20ZM12.5 6C8.91 6 6 8.91 6 12.5C6 13.83 6.41 15.06 7.11 16.07L6.44 18L8.37 17.33C9.38 18.03 10.61 18.44 11.94 18.44C15.53 18.44 18.44 15.53 18.44 11.94C18.44 8.35 15.53 5.44 11.94 5.44H12.5V6ZM16.02 14.24C15.9 14.19 15.34 13.92 15.24 13.89C15.14 13.86 15.06 13.84 14.98 13.96C14.9 14.08 14.69 14.33 14.62 14.41C14.55 14.49 14.48 14.5 14.36 14.45C14.24 14.4 13.82 14.26 13.33 13.82C12.95 13.48 12.71 13.05 12.64 12.93C12.57 12.81 12.62 12.75 12.67 12.7C12.72 12.65 12.78 12.58 12.83 12.51C12.88 12.44 12.9 12.39 12.93 12.31C12.96 12.23 12.95 12.16 12.92 12.11C12.89 12.06 12.69 11.5 12.6 11.26C12.51 11.02 12.42 11.05 12.34 11.05H12.14C12.06 11.05 11.93 11.08 11.82 11.2C11.71 11.32 11.42 11.59 11.42 12.15C11.42 12.71 11.83 13.25 11.88 13.33C11.93 13.41 12.69 14.62 13.88 15.08C14.95 15.49 15.07 15.4 15.25 15.38C15.43 15.36 15.9 15.12 16 14.85C16.1 14.58 16.1 14.35 16.07 14.29C16.04 14.23 15.96 14.2 15.84 14.15L16.02 14.24Z" fill="currentColor"/>
      </svg>
    </a>
  </div>
</div>

<style>
  .mobile-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 0.6rem;
    align-items: center;
    padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom, 0));
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--border);
    z-index: 20;
  }
  .mobile-cta__main {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
  }
  .mobile-cta__group {
    display: flex;
    gap: 0.5rem;
  }
  .mobile-cta__group a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--ink);
  }
  @media (min-width: 768px) {
    .mobile-cta {
      display: none;
    }
  }
</style>
