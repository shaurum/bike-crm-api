---
import { site } from '../config/site';
const base = import.meta.env.BASE_URL;
---
<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href={`${base}`}>
      <img src={`${base}logo.webp`} alt={site.name} onerror={`this.src='${base}logo.png'`} />
    </a>
    <nav class="header__nav">
      <a href="#bikes">Байки</a>
      <a href="#how">Как взять</a>
      <a href="#contacts">Контакты</a>
    </nav>
    <a class="btn btn--yellow header__cta" href={`tel:${site.phoneRaw}`}>Позвонить</a>
    <button class="header__menu" aria-label="Меню">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
  }
  .header__logo img {
    height: 44px;
    width: auto;
  }
  .header__nav {
    display: none;
    gap: 2rem;
    align-items: center;
  }
  .header__nav a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
    font-size: 0.98rem;
    position: relative;
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 2px;
    background: var(--yellow);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 200ms ease;
  }
  .header__nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .header__cta {
    display: none;
    padding: 0.7rem 1.6rem;
  }
  .header__menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: transparent;
    border: none;
    padding: 8px;
  }
  .header__menu span {
    width: 22px;
    height: 2px;
    background: var(--ink);
  }
  @media (min-width: 768px) {
    .header__nav { display: flex; }
    .header__cta { display: inline-flex; }
    .header__menu { display: none; }
  }
</style>
